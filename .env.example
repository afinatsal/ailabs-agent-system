# ================================
# LLM provider
#   gemini        -> pakai Google AI (google-genai)
#   deepseek      -> pakai DeepSeek (OpenAI-compatible API)
#   openai_compat -> proxy OpenAI-compatible (9router/kuroko, base URL + /v1)
#   mock          -> tanpa API key, output deterministic (untuk demo/testing)
# ================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=kr/auto
DEFAULT_MODEL=gemini-3.5-flash-lite

# ================================
# Supabase (Postgres + pgvector)
# Semua tabel AI Labs ada di schema `ailabs` (terpisah dari `public`).
# Key baru: PUBLISHABLE = pengganti anon (RLS aktif) | SECRET = pengganti
# service_role (bypass RLS). Set salah satunya; app memakai SECRET > PUBLISHABLE.
# SUPABASE_ANON_KEY (legacy) masih didukung kalau kamu pakai key lama.
# ================================
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# SUPABASE_ANON_KEY=

# ================================
# Perilaku orkestrasi
# ================================
REVIEWER_ENABLED=true
MAX_EXEC_RETRIES=2
MAX_REVIEW_ROUNDS=2

# Delegasi task koding ke agent opencode (CLI). true = Dev memanggil opencode
# untuk menulis/mengedit file di folder project.
ENABLE_OPENCODE=false

# ================================
# Obsidian vault (opsional) — folder tempat .md disimpan
# ================================
OBSIDIAN_VAULT_PATH=

# ================================
# Workspace lokal untuk file hasil agent (default: <project>/workspace)
# Dipakai oleh skill write_file/read_file/list_files
# ================================
LOCAL_WORKSPACE_PATH=
